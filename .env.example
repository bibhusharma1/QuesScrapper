# QuesScrapper configuration — copy me to .env and edit.
#
# How values are read:
#   - Lists are comma-separated (spaces after commas are fine).
#   - Real environment variables (shell, container) override this file.
#
# Paths are relative to the project root (or relative to the container
# workdir). Only relative paths are used in this project.

# Folders to scan recursively for *.pdf files. Comma-separated to read
# from several directories at once.
QUES_INPUT_DIRS=sampleData/ques_bank

# OPTIONAL: read ONLY these specific PDF files. Comma-separated.
# When set, the folders in QUES_INPUT_DIRS are ignored and exactly the
# listed files are read — so you can pick out particular papers.
# Example (relative paths only):
# QUES_INPUT_PDFS=sampleData/ques_bank/CS231 DATA STRUCTURES_MID.pdf

# Temp extraction folder (rendered pages, images, per-page text).
# Disposable — safe to delete; re-runs regenerate it.
QUES_OUTPUT_DIR=sampleData/ques_bank/output

# The dataset file every run appends records into.
# THE one output to keep — change the folder/name freely, e.g. a folder
# you mount for the saved JSON in deployment.
QUES_QUESTIONS_JSON=sampleData/ques_bank/output/questions_data.json
